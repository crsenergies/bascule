# Copy to .env and fill only the providers you use. Empty = provider disabled.
# Key your clients must send. Empty = no auth (only safe on 127.0.0.1). `bascule init` generates one.
BASCULE_KEY=
GROQ_API_KEY=
# Optional extra key from another project of yours: rotated on 429.
GROQ_API_KEY_2=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
