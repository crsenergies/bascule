{
  "port": 20129,
  "host": "127.0.0.1",
  "timeoutMs": 120000,
  "firstByteTimeoutMs": 30000,
  "idleTimeoutMs": 60000,
  "maxWaitMs": 20000,
  "compactWhitespace": true,
  "cache": { "maxEntries": 500, "ttlMs": 600000, "always": false },
  "corsOrigins": [],
  "log": true,
  "defaultModel": "auto",

  "providers": {
    "groq":       { "type": "openai", "baseUrl": "https://api.groq.com/openai/v1", "keys": ["${GROQ_API_KEY}", "${GROQ_API_KEY_2}"],
                    "models": ["openai/gpt-oss-120b", "openai/gpt-oss-20b", "llama-3.3-70b-versatile", "llama-3.1-8b-instant"] },
    "cerebras":   { "type": "openai", "baseUrl": "https://api.cerebras.ai/v1", "keys": ["${CEREBRAS_API_KEY}"],
                    "models": ["gpt-oss-120b", "qwen-3.8-27b"] },
    "gemini":     { "type": "openai", "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai", "keys": ["${GEMINI_API_KEY}"],
                    "models": ["gemini-3.8-flash", "gemini-3.5-flash-lite"] },
    "openrouter": { "type": "openai", "baseUrl": "https://openrouter.ai/api/v1", "keys": ["${OPENROUTER_API_KEY}"],
                    "models": ["openrouter/free", "qwen/qwen3.8-27b:free", "google/gemma-4-31b-it:free"] },
    "mistral":    { "type": "openai", "baseUrl": "https://api.mistral.ai/v1", "keys": ["${MISTRAL_API_KEY}"], "streamUsage": false,
                    "models": ["mistral-small-latest", "mistral-large-latest"] },
    "deepseek":   { "type": "openai", "baseUrl": "https://api.deepseek.com/v1", "keys": ["${DEEPSEEK_API_KEY}"],
                    "models": ["deepseek-flash", "deepseek-v4-pro"] },
    "openai":     { "type": "openai", "baseUrl": "https://api.openai.com/v1", "keys": ["${OPENAI_API_KEY}"],
                    "models": ["gpt-6-luna", "gpt-6-sol"] },
    "anthropic":  { "type": "anthropic", "baseUrl": "https://api.anthropic.com", "keys": ["${ANTHROPIC_API_KEY}"],
                    "models": ["claude-sonnet-5", "claude-haiku-4-5-20251001"] },
    "ollama":     { "type": "openai", "baseUrl": "http://127.0.0.1:11434/v1", "requiresKey": false,
                    "models": ["qwen2.5:3b"] }
  },

  "combos": {
    "auto":  ["groq/openai/gpt-oss-120b", "cerebras/gpt-oss-120b", "gemini/gemini-3.5-flash-lite",
              "openrouter/openrouter/free", "mistral/mistral-small-latest", "deepseek/deepseek-flash", "ollama/qwen2.5:3b"],
    "fast":  { "strategy": "fastest", "targets": ["groq/openai/gpt-oss-20b", "cerebras/gpt-oss-120b", "gemini/gemini-3.5-flash-lite"] },
    "smart": ["anthropic/claude-sonnet-5", "gemini/gemini-3.8-flash", "openai/gpt-6-sol", "deepseek/deepseek-v4-pro", "groq/openai/gpt-oss-120b"],
    "local": ["ollama/qwen2.5:3b"]
  }
}
