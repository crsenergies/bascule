{
  "port": 20129,
  "host": "127.0.0.1",
  "timeoutMs": 120000,
  "firstByteTimeoutMs": 30000,
  "compactWhitespace": true,
  "cache": { "maxEntries": 500, "ttlMs": 600000, "always": false },
  "defaultModel": "auto",

  "providers": {
    "groq":       { "type": "openai", "baseUrl": "https://api.groq.com/openai/v1", "keys": ["${GROQ_API_KEY}", "${GROQ_API_KEY_2}"],
                    "models": ["llama-3.3-70b-versatile", "llama-3.1-8b-instant"] },
    "cerebras":   { "type": "openai", "baseUrl": "https://api.cerebras.ai/v1", "keys": ["${CEREBRAS_API_KEY}"],
                    "models": ["llama-3.3-70b"] },
    "gemini":     { "type": "openai", "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai", "keys": ["${GEMINI_API_KEY}"],
                    "models": ["gemini-2.5-flash", "gemini-2.5-pro"] },
    "openrouter": { "type": "openai", "baseUrl": "https://openrouter.ai/api/v1", "keys": ["${OPENROUTER_API_KEY}"],
                    "models": ["deepseek/deepseek-chat-v3-0324:free"] },
    "mistral":    { "type": "openai", "baseUrl": "https://api.mistral.ai/v1", "keys": ["${MISTRAL_API_KEY}"],
                    "models": ["mistral-small-latest"] },
    "deepseek":   { "type": "openai", "baseUrl": "https://api.deepseek.com/v1", "keys": ["${DEEPSEEK_API_KEY}"],
                    "models": ["deepseek-chat"] },
    "openai":     { "type": "openai", "baseUrl": "https://api.openai.com/v1", "keys": ["${OPENAI_API_KEY}"],
                    "models": ["gpt-4o-mini"] },
    "anthropic":  { "type": "anthropic", "baseUrl": "https://api.anthropic.com", "keys": ["${ANTHROPIC_API_KEY}"],
                    "models": ["claude-sonnet-5", "claude-haiku-4-5-20251001"] },
    "ollama":     { "type": "openai", "baseUrl": "http://127.0.0.1:11434/v1", "requiresKey": false,
                    "models": ["qwen2.5:3b"] }
  },

  "combos": {
    "auto":  ["groq/llama-3.3-70b-versatile", "cerebras/llama-3.3-70b", "gemini/gemini-2.5-flash",
              "openrouter/deepseek/deepseek-chat-v3-0324:free", "mistral/mistral-small-latest", "ollama/qwen2.5:3b"],
    "fast":  { "strategy": "fastest", "targets": ["groq/llama-3.1-8b-instant", "cerebras/llama-3.3-70b", "gemini/gemini-2.5-flash"] },
    "smart": ["anthropic/claude-sonnet-5", "gemini/gemini-2.5-pro", "deepseek/deepseek-chat", "groq/llama-3.3-70b-versatile"],
    "local": ["ollama/qwen2.5:3b"]
  }
}
